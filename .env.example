APP_ENV=development
APP_ORIGIN=http://localhost:3100
DATABASE_URL=postgresql+psycopg://dayzero:local_demo_only@db:5432/dayzero
CHECKPOINT_DATABASE_URL=postgresql://dayzero_checkpoint:local_demo_only@db:5432/dayzero
RAG_DATABASE_URL=postgresql://dayzero_rag:local_demo_only@db:5432/dayzero
INDEXER_DATABASE_URL=postgresql://dayzero_indexer:local_demo_only@db:5432/dayzero
GATEWAY_INTERNAL_URL=http://gateway:8000
AGENT_INTERNAL_URL=http://agent:8001
BUSINESS_MCP_URL=http://business-mcp:9101/mcp
RAG_MCP_URL=http://rag-mcp:9102/mcp
RAG_MODE=vector
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
INDEX_VERSION=fitmoa-index-v1
HF_HOME=/app/.cache/hf
LLM_MODE=fixture
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
JWT_SECRET=
INTERNAL_SERVICE_SECRET=
SEED_ADMIN_EMAIL=admin@dayzero.local
SEED_ADMIN_PASSWORD=
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dayzero-seonjeong-mvp
EVENT_E4_ENABLED=true

# 회사 기준 company-mcp (company_id=url, 쉼표 구분). gateway만 읽는다
COMPANY_MCP_URLS=a-startup=http://localhost:9201/mcp,b-finance=http://localhost:9202/mcp
DEFAULT_COMPANY_ID=a-startup
# dayzero-mcp 평가자용 토큰(직접 생성: openssl rand -hex 24). 문서·로그에 값을 쓰지 않는다
DAYZERO_MCP_TOKEN=
